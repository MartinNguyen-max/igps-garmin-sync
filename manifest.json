{
  "manifest_version": 3,
  "name": "iGPSPORT to Garmin Sync",
  "version": "1.0.1",
  "description": "Automatically syncs your rides from iGPSPORT directly to Garmin Connect with one click.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "igpsport-garmin-sync-icon-as-png.png",
      "48": "igpsport-garmin-sync-icon-as-png.png",
      "128": "igpsport-garmin-sync-icon-as-png.png"
    }
  },
  "icons": {
    "16": "igpsport-garmin-sync-icon-as-png.png",
    "48": "igpsport-garmin-sync-icon-as-png.png",
    "128": "igpsport-garmin-sync-icon-as-png.png"
  },
  "permissions": ["activeTab", "scripting", "tabs"],
  "host_permissions": [
    "https://*.igpsport.com/*",
    "https://*.aliyuncs.com/*",
    "https://*.garmin.com/*"
  ]
}
